{
  "name": "speed-for-need",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --directory dist --bind 127.0.0.1",
    "check": "node --check dist/game.js && node --check dist/world.js && node --check dist/traffic.js && node --check dist/physics.js && node --check electron-main.mjs && node --check electron-menu.mjs && node --check electron-ipc.mjs && node --check electron-protocol.mjs && node --check electron-smoke.mjs && node --check preload.cjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "electron": "electron .",
    "electron:smoke": "ELECTRON_SMOKE=1 electron .",
    "pack": "electron-builder --dir",
    "dist:app": "electron-builder",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs"
  },
  "main": "electron-main.mjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "description": "SPEED FOR NEED \u2014 open-world arcade racer (three.js + Planck.js) for browser and desktop (Electron).",
  "author": "Aryan Kinha",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.speedforneed.game",
    "productName": "SPEED FOR NEED",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-main.mjs",
      "electron-menu.mjs",
      "electron-ipc.mjs",
      "electron-protocol.mjs",
      "electron-smoke.mjs",
      "electron-security.mjs",
      "preload.cjs",
      "build/icon.png",
      "package.json",
      "dist/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "copyright": "Open-source assets credited in dist/CREDITS.md",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
